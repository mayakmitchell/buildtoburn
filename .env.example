# Server-only URL for the Google Apps Script web app that stores subscribers.
# Configure this in Vercel for Production, Preview, and Development.
SIGNUP_WEB_APP_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Must match the SIGNUP_SHARED_SECRET Apps Script property.
SIGNUP_SHARED_SECRET=replace-with-a-long-random-value
